[Unit]
Description=BSV ALL BSV1 isolated staging

[Service]
Type=simple
User=bsv-all-stage
Group=bsv-all-stage
EnvironmentFile=/etc/bsv-all-bsv1-stage.env
ExecStart=/usr/bin/python3 -u /opt/bsv-all-bsv1-stage/current/services/api/bsv1/app.py
Restart=on-failure
RestartSec=5
UMask=0077
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
StateDirectory=bsv-all-bsv1-stage
StateDirectoryMode=0700
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
