[Unit]
Description=BSV ALL isolated internal stage (%i)
After=network.target

[Service]
Type=simple
User=bsvint-%i
Group=bsvint-%i
WorkingDirectory=/opt/bsv-all-internal-stage/current
EnvironmentFile=/opt/bsv-all-internal-stage/config/%i.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/bin/bash /opt/bsv-all-internal-stage/current/platform/lighthouse/internal-stage/run.sh %i
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/bsv-all-internal-stage/%i
UMask=0077
