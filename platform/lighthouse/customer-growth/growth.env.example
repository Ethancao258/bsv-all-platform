# DO NOT COPY THIS FILE AS A LIVE SECRET FILE. Fill the actual values in /etc/bsv/growth.env (mode 0600).
BSV_GROWTH_ENV=production
BSV_GROWTH_DB_URL=postgresql+psycopg://USER:PASSWORD@PRIVATE_HOST:5432/BSV_DATABASE
BSV_GROWTH_STORE_IDS=BSVM,BSVS,BSVT
BSV_GROWTH_LEGAL_ENTITY_ID=REPLACE_WITH_VERIFIED_LEGAL_ENTITY_ID
BSV_GROWTH_IDENTITY_ME_URL=http://127.0.0.1:REPLACE_WITH_INTERNAL_IDENTITY_PORT/api/v1/identity/me
BSV_GROWTH_ALLOWED_ORIGINS=https://REPLACE_WITH_PUBLIC_HOST
BSV_GROWTH_PUBLIC_BASE_URL=https://REPLACE_WITH_PUBLIC_HOST
BSV_GROWTH_SIGNING_KEY=REPLACE_WITH_32+_RANDOM_CHARACTERS
BSV_GROWTH_SIGNATURE_KEY=REPLACE_WITH_FERNET_KEY
BSV_GROWTH_PAYMENT_SIGNING_KEY=REPLACE_WITH_32+_RANDOM_CHARACTERS
BSV_GROWTH_MEMBER_POLICY_VERSION=REPLACE_WITH_APPROVED_MEMBER_POLICY_VERSION
BSV_WECHAT_APPID=REPLACE_WITH_OFFICIAL_ACCOUNT_APPID
BSV_WECHAT_SECRET=REPLACE_WITH_OFFICIAL_ACCOUNT_SECRET
BSV_WECHAT_REDIRECT=https://REPLACE_WITH_PUBLIC_HOST/api/v1/growth/auth/wechat/callback
