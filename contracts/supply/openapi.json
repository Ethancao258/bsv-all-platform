  "components": {
    "schemas": {
      "Action": {
        "properties": {
          "request_id": {
            "type": "string",
            "format": "uuid",
            "title": "Request Id"
          },
          "expected_version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Expected Version"
          }
        },
        "type": "object",
        "required": [
          "request_id",
          "expected_version"
        ],
        "title": "Action"
      },
      "Body_photo_preview_api_photo_preview_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          },
          "consent_external": {
            "type": "boolean",
            "title": "Consent External",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_photo_preview_api_photo_preview_post"
      },
      "BucketCount": {
        "properties": {
          "request_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Request Id"
          },
          "store_id": {
            "type": "string",
            "title": "Store Id"
          },
          "item_id": {
            "type": "string",
            "title": "Item Id"
          },
          "full_packages": {
            "type": "integer",
            "title": "Full Packages"
          },
          "opened_count": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Opened Count"
          },
          "opened_percent": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Opened Percent"
          }
        },
        "type": "object",
        "required": [
          "store_id",
          "item_id",
          "full_packages",
          "opened_count"
        ],
        "title": "BucketCount"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Inspection": {
        "properties": {
          "request_id": {
            "type": "string",
            "format": "uuid",
            "title": "Request Id"
          },
          "store_id": {
            "type": "string",
            "title": "Store Id"
          },
          "subject_department": {
            "type": "string",
            "title": "Subject Department",
            "default": ""
          },
          "subject_employee": {
            "type": "string",
            "title": "Subject Employee",
            "default": ""
          },
          "results": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Results"
          },
          "kind": {
            "type": "string",
            "enum": [
              "self_check",
              "independent"
            ],
            "title": "Kind",
            "default": "self_check"
          }
        },
        "type": "object",
        "required": [
          "request_id",
          "store_id",
          "results"
        ],
        "title": "Inspection"
      },
      "InspectionReview": {
        "properties": {
          "request_id": {
            "type": "string",
            "format": "uuid",
            "title": "Request Id"
          },
          "decision": {
            "type": "string",
            "enum": [
              "APPROVED",
              "CHANGES_REQUIRED"
            ],
            "title": "Decision"
          }
        },
        "type": "object",
        "required": [
          "request_id",
          "decision"
        ],
        "title": "InspectionReview"
      },
      "Lines": {
        "properties": {
          "item_id": {
            "type": "string",
            "title": "Item Id"
          },
          "packages": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 1.0,
            "title": "Packages"
          }
        },
        "type": "object",
        "required": [
          "item_id",
          "packages"
        ],
        "title": "Lines"
      },
      "ReceiveAction": {
        "properties": {
          "request_id": {
            "type": "string",
            "format": "uuid",
            "title": "Request Id"
          },
          "expected_version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Expected Version"
          },
          "scanned_codes": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 300,
            "minItems": 1,
            "title": "Scanned Codes"
          },
          "condition": {
            "type": "string",
            "title": "Condition",
            "default": "ACCEPTED"
          }
        },
        "type": "object",
        "required": [
          "request_id",
          "expected_version",
          "scanned_codes"
        ],
        "title": "ReceiveAction"
      },
      "Replenishment": {
        "properties": {
          "confirmed_available": {
            "type": "string",
            "title": "Confirmed Available"
          },
          "usage_before_next": {
            "type": "string",
            "title": "Usage Before Next"
          },
          "arrivals_before_next": {
            "type": "string",
            "title": "Arrivals Before Next"
          },
          "reserved": {
            "type": "string",
            "title": "Reserved"
          },
          "expiry_before_next": {
            "type": "string",
            "title": "Expiry Before Next"
          },
          "demand_next_cycle": {
            "type": "string",
            "title": "Demand Next Cycle"
          },
          "safety_stock": {
            "type": "string",
            "title": "Safety Stock"
          },
          "arrivals_next_cycle": {
            "type": "string",
            "title": "Arrivals Next Cycle"
          },
          "pack_size": {
            "type": "string",
            "title": "Pack Size"
          },
          "approved": {
            "type": "boolean",
            "title": "Approved",
            "default": true
          },
          "reliable": {
            "type": "boolean",
            "title": "Reliable",
            "default": true
          },
          "max_packs": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Packs"
          }
        },
        "type": "object",
        "required": [
          "confirmed_available",
          "usage_before_next",
          "arrivals_before_next",
          "reserved",
          "expiry_before_next",
          "demand_next_cycle",
          "safety_stock",
          "arrivals_next_cycle",
          "pack_size"
        ],
        "title": "Replenishment"
      },
      "ScanAction": {
        "properties": {
          "request_id": {
            "type": "string",
            "format": "uuid",
            "title": "Request Id"
          },
          "expected_version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Expected Version"
          },
          "scanned_codes": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 300,
            "minItems": 1,
            "title": "Scanned Codes"
          }
        },
        "type": "object",
        "required": [
          "request_id",
          "expected_version",
          "scanned_codes"
        ],
        "title": "ScanAction"
      },
      "ShipmentCreate": {
        "properties": {
          "request_id": {
            "type": "string",
            "format": "uuid",
            "title": "Request Id"
          },
          "source_store_id": {
            "type": "string",
            "title": "Source Store Id"
          },
          "dest_store_id": {
