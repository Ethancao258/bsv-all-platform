  "change_type_rules": {
    "UI_COPY": {
      "deploy": "isolated_after_ci",
      "must_not_change": [
        "auth_grants",
        "database_schema",
        "payments"
      ],
      "required_tests": [
        "render",
        "business_copy",
        "existing_auth_rejection"
      ]
    },
    "UI_FLOW": {
      "deploy": "isolated_after_ci",
      "required_tests": [
        "browser_e2e",
        "keyboard",
        "error_feedback",
        "role_rejection"
      ]
    },
    "API_LOGIC": {
      "deploy": "isolated_after_ci_and_review",
      "required_tests": [
        "positive",
        "negative",
        "idempotency",
        "cross_store",
        "integration"
      ]
    },
    "SECURITY_GRANT": {
      "deploy": "separate_security_approval",
      "required_tests": [
        "least_privilege",
        "revocation",
        "two_person",
        "audit"
      ]
    },
    "SOURCE_ENDPOINT": {
      "deploy": "review_connection_and_rollback",
      "required_tests": [
        "endpoint_contract",
        "tls",
        "minimum_permissions",
        "schema_compatibility",
        "read_fallback_only"
      ]
    },
    "SCHEMA_MIGRATION": {
      "deploy": "no_production_without_g0_g1_and_restore",
      "required_tests": [
        "up_down",
        "restore",
        "integrity",
        "ownership",
        "rollback"
      ]
    },
    "OPERATIONS": {
      "deploy": "approved_sha_only",
      "required_tests": [
        "preflight",
        "backup",
        "loopback",
        "old_services",
        "rollback"
      ]
    },
    "HARDWARE": {
      "deploy": "device_lab_then_store_approval",
      "required_tests": [
        "print_accuracy",
        "offline_behavior",
        "physical_safety"
      ]
    }
  },
  "release_gates": [
    "approved_SHA",
    "CI_success",
    "preflight",
    "backup_check",
    "new_ports_loopback",
    "old_services_stay_active",
    "batch_acceptance",
    "rollback_available"
  ],
  "never_auto_approve": [
    "production_cloudbase_write",
    "payment_activation",
    "live_identity_migration",
    "authoritative_database_switchover",
    "public_internet_exposure"
  ],
  "suggested_control_cli": [
    "bsvctl.py status",
    "bsvctl.py deploy --sha <40位SHA> --ci-proof <GitHub导出> --approve-isolated --request-id <编号> --module <模块>",
    "bsvctl.py verify",
    "bsvctl.py rollback",
    "acceptance.py --expected-sha <40位SHA> --execute-isolated"
  ],
  "control_cli_status": "ISOLATED_MANUAL_IMPLEMENTED_HOST_NOT_RUN"
}
