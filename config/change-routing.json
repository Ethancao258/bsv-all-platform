{
  "schema_version": "1.0",
  "specification": "docs/architecture/BSV_ALL_DELIVERY_CONTROL_PLANE_V1.md",
  "classification": "CHANGE_ROUTING_INDEX_NOT_RUNTIME_SECRETS",
  "default_environment": "isolated",
  "notes": [
    "Module owners and code-path hints for ChatGPT/Codex; authoritative identities remain in config/data-ownership.json.",
    "Datasource aliases MUST be namespace-qualified; identity.A is not supply.A.",
    "Status values are current isolated-stage evidence or planned capabilities, not production availability.",
    "Never store endpoints, tokens, PII or production credentials in this file."
  ],
  "data_source_namespaces": {
    "identity.A": {
      "purpose": "唯一人员身份可写事实",
      "config": "config/modules/identity-data-sources.json",
      "runtime_env": "BSV_DB_URL",
      "compatibility_envs": ["BSV_DB_A_URL"],
      "allow_use": "isolated_current; production_blocked"
    },
    "identity.B": {
      "purpose": "可选非敏感只读参考",
      "config": "config/modules/identity-data-sources.json",
      "runtime_env": "BSV_DB_B_READONLY_URL",
      "allow_use": "READ_ONLY_OPTIONAL"
    },
    "identity.LOCAL": {
      "purpose": "加密身份灾备；不能代替实时鉴权",
      "config": "config/modules/identity-data-sources.json",
      "runtime_env": "BSV_LOCAL_ARCHIVE_DIR",
      "allow_use": "BACKUP_ONLY"
    },
    "supply.A": {
      "purpose": "产品与物料主数据",
      "config": "config/modules/supply-sources.example.json",
      "allow_use": "BLOCKED_NOT_INTEGRATED"
    },
    "supply.B": {
      "purpose": "统一身份与权限只读API",
      "config": "config/modules/supply-sources.example.json",
      "allow_use": "READ_ONLY_ISOLATED"
    },
    "supply.C": {
      "purpose": "门店与库位主数据",
      "config": "config/modules/supply-sources.example.json",
      "allow_use": "BLOCKED_NOT_INTEGRATED"
    },
    "supply.D": {
      "purpose": "唯一中央库存/配送事实账本",
      "config": "config/modules/supply-sources.example.json",
      "allow_use": "BLOCKED_NOT_INTEGRATED"
    },
    "supply.E": {
      "purpose": "独立督查权威事件",
      "config": "config/modules/supply-sources.example.json",
      "allow_use": "BLOCKED_NOT_INTEGRATED"
    },
    "supply.F": {
      "purpose": "可选视觉候选",
      "config": "config/modules/supply-sources.example.json",
      "allow_use": "OPTIONAL_NOT_INTEGRATED"
    },
    "supply.G": {
      "purpose": "事件通知",
      "config": "config/modules/supply-sources.example.json",
      "allow_use": "OPTIONAL_NOT_INTEGRATED"
    }
  },
